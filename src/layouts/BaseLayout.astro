---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Aerospace Engineering Portfolio',
  description = 'Aerospace engineering work documented through design, analysis, fabrication, and validation.'
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071018" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Sans:wdth,wght@75..100,400..700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
    <script is:inline>
      const nav = document.querySelector('[data-nav]');
      const toggle = document.querySelector('[data-nav-toggle]');

      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open') ?? false;
        toggle.setAttribute('aria-expanded', String(open));
      });

      document.querySelectorAll('[data-nav-link]').forEach((link) => {
        link.addEventListener('click', () => {
          nav?.classList.remove('is-open');
          toggle?.setAttribute('aria-expanded', 'false');
        });
      });

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle('is-visible', entry.isIntersecting);
        });
      }, { threshold: 0.12 });

      document.querySelectorAll('[data-reveal]').forEach((element) => observer.observe(element));

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      document.querySelectorAll('[data-project-video]').forEach((element) => {
        if (element instanceof HTMLVideoElement && reducedMotion.matches) {
          element.pause();
          element.currentTime = 0;
        }
      });

      document.querySelectorAll('[data-project-focus]').forEach((section) => {
        const tabs = Array.from(section.querySelectorAll('[data-focus-tab]'));
        const panels = Array.from(section.querySelectorAll('[data-focus-panel]'));

        const activateTab = (nextTab) => {
          if (!(nextTab instanceof HTMLButtonElement)) return;
          const panelId = nextTab.getAttribute('aria-controls');

          tabs.forEach((tab) => {
            const active = tab === nextTab;
            tab.setAttribute('aria-selected', String(active));
            tab.setAttribute('tabindex', active ? '0' : '-1');
          });

          panels.forEach((panel) => {
            panel.hidden = panel.id !== panelId;
          });
        };

        tabs.forEach((tab, index) => {
          tab.addEventListener('click', () => activateTab(tab));
          tab.addEventListener('keydown', (event) => {
            if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
            event.preventDefault();
            const offset = event.key === 'ArrowRight' ? 1 : -1;
            const nextTab = tabs[(index + offset + tabs.length) % tabs.length];
            activateTab(nextTab);
            nextTab.focus();
          });
        });
      });

      const fallbackCopy = (value) => {
        const field = document.createElement('textarea');
        field.value = value;
        field.setAttribute('readonly', '');
        field.style.position = 'fixed';
        field.style.opacity = '0';
        field.style.pointerEvents = 'none';
        document.body.append(field);
        field.select();
        const copyCommand = Reflect.get(document, 'execCommand');
        const copied = typeof copyCommand === 'function' && Boolean(Reflect.apply(copyCommand, document, ['copy']));
        field.remove();
        return copied;
      };

      document.querySelectorAll('[data-email-copy]').forEach((link) => {
        link.addEventListener('click', async (event) => {
          if (!(link instanceof HTMLAnchorElement) || link.dataset.copying === 'true') return;
          event.preventDefault();

          const address = link.dataset.emailAddress ?? '';
          const label = link.querySelector('[data-email-copy-label]');
          const icon = link.querySelector('[data-email-copy-icon]');
          const originalLabel = label?.textContent ?? address;
          const originalIcon = icon?.textContent ?? '↗';
          link.dataset.copying = 'true';

          let copied = false;
          try {
            await navigator.clipboard.writeText(address);
            copied = true;
          } catch {
            copied = fallbackCopy(address);
          }

          link.classList.add('is-copied');
          if (label) label.textContent = copied ? 'Copied — opening mail app…' : 'Opening mail app…';
          if (icon) icon.textContent = copied ? '✓' : '↗';

          window.setTimeout(() => {
            window.location.href = link.href;
          }, 850);

          window.setTimeout(() => {
            link.classList.remove('is-copied');
            delete link.dataset.copying;
            if (label) label.textContent = originalLabel;
            if (icon) icon.textContent = originalIcon;
          }, 2600);
        });
      });
    </script>
  </body>
</html>
