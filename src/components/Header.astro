---
interface Props {
  detail?: boolean;
}

const { detail = false } = Astro.props;
---

<header class="site-header" data-nav>
  <a class="wordmark" href="/" aria-label="Beckham Moreland portfolio home">
    <span class="wordmark__text">Beckham Moreland</span>
  </a>

  <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-expanded="false" data-nav-toggle>
    <span></span><span></span>
  </button>

  <nav class="site-nav" aria-label="Primary navigation">
    <a href={detail ? '/#about' : '#about'} data-nav-link>About</a>
    <a href={detail ? '/#experience' : '#experience'} data-nav-link>Experience</a>
    <a href={detail ? '/#work' : '#work'} data-nav-link>Work</a>
    <a href="/resume/" data-nav-link>Résumé</a>
  </nav>
  <a class="contact-cta" href={detail ? '/#contact' : '#contact'} data-contact-trigger>
    Contact <span aria-hidden="true">↘</span>
  </a>
</header>
