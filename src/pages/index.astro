---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import MediaPlaceholder from '../components/MediaPlaceholder.astro';
import { campusActivities, experiences } from '../data/experience';

const projects = await getCollection('projects', ({ data }) => data.published);
const sorted = projects.sort((a, b) => Number(b.data.featured) - Number(a.data.featured));
const [primary, ...secondary] = sorted;
---

<BaseLayout title="Beckham Moreland Portfolio">
  <Header />
  <main id="main">
    <section class="hero shell">
      <div class="hero__stage">
        <div class="hero__copy" data-reveal>
          <div class="hero__name-block">
            <h1><span>Beckham</span><span class="hero__surname">Moreland</span></h1>
            <p class="hero__location">San Diego <span>/</span> Bay Area</p>
          </div>
          <p class="hero__role">Aerospace engineer focused on autonomy, test &amp; evaluation, integration, and embedded software.</p>
          <p class="hero__lead">
            I’m driven by work with real ownership. I want to build and integrate aerospace systems that perform outside the lab and help create the next generation of autonomous aircraft by carrying ideas from analysis through hardware, test, and flight.
          </p>
          <div class="hero__actions">
            <a class="button button--text" href="/resume/">Open résumé <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <div class="scroll-cue" aria-hidden="true">
          <span>Scroll to explore</span>
          <i></i>
        </div>
      </div>
    </section>

    <section class="about shell" id="about">
      <div class="about__intro" data-reveal>
        <p class="section-label">01 / About</p>
        <h2>Learning by building,<br /><em>testing, and iterating.</em></h2>
        <p class="about__lead">
          I’m an aerospace engineering sophomore at San Diego State University and a former NASA Ames UAS engineering intern. I’m passionate about autonomous flight, building reliable hardware, and using hands-on testing to understand how each design can perform better.
        </p>
        <p>
          This portfolio is a growing record of my engineering work, including the decisions, technical evidence, and individual contributions behind each result.
        </p>
      </div>

      <aside class="education-card" data-reveal aria-label="Education and interests">
        <div class="education-card__header">
          <p class="education-card__label">Education</p>
        </div>
        <div class="education-card__school">
          <div>
            <h3>San Diego State University</h3>
            <p>B.S. Aerospace Engineering</p>
          </div>
          <picture>
            <source media="(max-width: 760px)" srcset="/sdsu-monogram-white.png" />
            <img src="/sdsu-sd-mark.jpg" alt="SDSU SD mark" width="92" height="69" />
          </picture>
        </div>
        <dl class="education-card__facts">
          <div><dt>Grade level</dt><dd>Sophomore</dd></div>
          <div><dt>Cumulative GPA</dt><dd>3.72</dd></div>
          <div><dt>Location</dt><dd>San Diego, California</dd></div>
        </dl>
        <div class="education-card__coursework">
          <p>Relevant coursework</p>
          <ul>
            <li>Introduction to Aerospace</li>
            <li>Computer-Aided Design</li>
            <li>Calculus II/III</li>
            <li>Physics I/II</li>
            <li>Statics</li>
          </ul>
        </div>
        <div class="education-card__interests">
          <p>Technical interests</p>
          <ul>
            <li>Autonomy</li>
            <li>Test &amp; Evaluation</li>
            <li>Integration</li>
            <li>Embedded Software</li>
          </ul>
        </div>
      </aside>
    </section>

    <section class="experience shell" id="experience">
      <header class="experience__heading" data-reveal>
        <div>
          <p class="section-label">02 / Experience</p>
          <h2>Selected experience</h2>
        </div>
        <p>A concise record of the teams, systems, and responsibilities that have shaped my engineering work.</p>
      </header>

      <div class="campus-work" data-reveal>
        <div class="campus-work__label">
          <span>Current at SDSU</span>
          <p>Student teams and research</p>
        </div>
        <div class="campus-work__grid">
          {campusActivities.map((activity, index) => (
            <article class="campus-card">
              <header>
                <span>0{index + 1}</span>
                <p>{activity.status}</p>
              </header>
              <p class="campus-card__category">{activity.category}</p>
              <h3>{activity.title}</h3>
              <p class="campus-card__summary">{activity.summary}</p>
            </article>
          ))}
        </div>
      </div>

      <p class="professional-label" data-reveal>Professional experience</p>
      <div class="experience-list">
        {experiences.map((item, index) => (
          <article class="experience-item" data-reveal>
            <div class="experience-item__rail" aria-hidden="true">
              <span>{String(index + 1).padStart(2, '0')}</span>
            </div>
            <div class="experience-item__main">
              <header>
                <div>
                  <h3>{item.organization}</h3>
                  <p>{item.role}</p>
                </div>
                <div class="experience-item__meta">
                  <time>{item.dates}</time>
                  <span>{item.location}</span>
                  <div class:list={['experience-item__mark', { 'experience-item__mark--logo': item.logo }]} aria-hidden="true">
                    {item.logo ? <img src={item.logo} alt="" /> : item.shortMark}
                  </div>
                </div>
              </header>
              <ul>
                {item.highlights.map((highlight) => (
                  <li>
                    {highlight.split('**').map((segment, segmentIndex) =>
                      segmentIndex % 2 === 1 ? <strong>{segment}</strong> : segment
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="work shell" id="work">
      <header class="section-heading" data-reveal>
        <p>03 / Selected work</p>
        <h2>Engineering decisions,<br />documented end to end.</h2>
        <span>01 project record</span>
      </header>

      <article class="featured-project" data-reveal>
        <a class="featured-project__media" href={`/projects/${primary.data.slug}/`} aria-label={`Open ${primary.data.title}`}>
          <div class="featured-project__video">
            <video
              data-project-video
              autoplay
              muted
              loop
              playsinline
              preload="auto"
              disablepictureinpicture
              controlslist="nodownload nofullscreen noremoteplayback"
              aria-label="NASA Ames UAS engineering project footage"
            >
              <source src="/media/nasa-ames-uas-banner.mp4" type="video/mp4" />
            </video>
            <span class="featured-project__video-index">NASA / AMA / 01</span>
            <span class="featured-project__video-label">UAS prototyping · test · integration</span>
          </div>
        </a>
        <div class="featured-project__body">
          <div class="record-line">
            <span>PRJ.01</span>
          </div>
          <h3><a href={`/projects/${primary.data.slug}/`}>{primary.data.title}</a></h3>
          <p>{primary.data.summary}</p>
          <ul class="tag-list" aria-label="Disciplines">
            {primary.data.disciplines.map((item) => <li>{item}</li>)}
          </ul>
          <a class="project-link" href={`/projects/${primary.data.slug}/`}>Read the project record <span aria-hidden="true">↗</span></a>
        </div>
      </article>

      {secondary.length > 0 && (
        <div class="secondary-projects">
          {secondary.map((project, index) => (
            <article class="secondary-project" data-reveal>
              <a href={`/projects/${project.data.slug}/`} aria-label={`Open ${project.data.title}`}>
                <MediaPlaceholder
                  label={project.data.title}
                  note={index === 0 ? 'Replace with analysis output or a technical plot' : 'Replace with build, integration, or test photography'}
                  ratio="square"
                  index={`PRJ. 0${index + 2} / MEDIA`}
                />
              </a>
              <div class="record-line">
                <span>PRJ.0{index + 2}</span><span>{project.data.revision}</span><span>{project.data.year}</span>
              </div>
              <h3><a href={`/projects/${project.data.slug}/`}>{project.data.title}</a></h3>
              <p>{project.data.summary}</p>
              <a class="project-link" href={`/projects/${project.data.slug}/`}>View record <span aria-hidden="true">↗</span></a>
            </article>
          ))}
        </div>
      )}
    </section>

    <section class="contact shell" id="contact" data-reveal>
      <p class="section-label">04 / Contact</p>
      <div>
        <h2>I’m always open to<br />new opportunities.</h2>
        <p>If you’re working on something interesting or think I could contribute to your team, feel free to reach out.</p>
      </div>
      <nav class="contact__links" aria-label="Contact links">
        <a href="mailto:beckham.hayes@gmail.com" data-email-copy data-email-address="beckham.hayes@gmail.com"><span>Email<small data-email-copy-label aria-live="polite">beckham.hayes@gmail.com</small></span><span class="contact__link-icon" data-email-copy-icon aria-hidden="true">↗</span></a>
        <a href="https://www.linkedin.com/in/becksm" target="_blank" rel="noreferrer"><span>LinkedIn<small>Click to connect with me!</small></span><span aria-hidden="true">↗</span></a>
      </nav>
    </section>
  </main>

  <footer class="site-footer shell">
    <span>BM / Portfolio R00</span>
    <a href="#main">Back to top ↑</a>
  </footer>

</BaseLayout>
